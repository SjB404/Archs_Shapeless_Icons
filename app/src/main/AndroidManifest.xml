<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app see every app that shows up in the launcher (needed for the export). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Shapeless Icons"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- These tell launchers "this app is an icon pack". -->
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.anddoes.launcher.THEME" />
                <category android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="com.teslacoilsw.launcher.THEME" />
            </intent-filter>
        </activity>

        <!-- Icon index: browse and search every icon in the pack. -->
        <activity
            android:name=".IconIndexActivity"
            android:exported="false"
            android:label="Icon index" />
    </application>
</manifest>
